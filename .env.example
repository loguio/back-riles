PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Supabase PostgreSQL Database (Transaction Mode Pooler)
DATABASE_URL="postgresql://postgres.bjktawrigqjshmayutac:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Database (Session Mode Direct / Migrations)
DIRECT_URL="postgresql://postgres.bjktawrigqjshmayutac:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase Project Secret & URL
SUPABASE_PROJECT_REF=bjktawrigqjshmayutac
SUPABASE_URL=https://bjktawrigqjshmayutac.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT Auth Secret (From Supabase Project Settings -> API -> JWT Secret)
# REQUIRED - the server refuses to start when neither variable is set (fail closed).
# Generate one with: openssl rand -hex 32
# SECURITY: a default value used to be hardcoded here, in the source and in
# docker-compose.yml. That value is public now: treat it as compromised, never
# reuse it, and rotate it in Supabase (Project Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=
JWT_SECRET=
JWT_EXPIRATION=7d

# Webhooks Verification Tokens & Secrets (tous fail-closed : sans secret, les
# webhooks correspondants sont rejetés en 401 — voir RILES-005)
STRAVA_VERIFY_TOKEN=your_strava_webhook_verify_token
GARMIN_WEBHOOK_SECRET=your_garmin_webhook_secret
APPLE_HEALTH_SECRET=your_apple_health_shared_secret

# Strava API (OAuth2 + signature HMAC des webhooks : X-Hub-Signature = sha1 HMAC
# du corps brut calculé avec STRAVA_CLIENT_SECRET — RILES-005)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:3000/api/v1/webhooks/strava/oauth/callback

# Redirection post-callback OAuth Strava (RILES-007 : plus jamais codée en dur)
FRONTEND_OAUTH_REDIRECT_URI=http://localhost:8081/onboarding?step=4&strava_synced=true

# Data Lake (Supabase Storage)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATALAKE_BUCKET_NAME=training-datalake

# Moteur LLM Multi-Provider (Gemini 3.5/3.8 Free Tier, OmniRoute :20128, Groq, OpenRouter)
# Option 1 (Défaut - Gratuit Google AI Studio) : https://generativelanguage.googleapis.com/v1beta/openai
# Option 2 (Gratuit Local OmniRoute) : http://localhost:20128/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_LIGHT_MODEL=gemini-3.5-flash-lite
LLM_PRO_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Ops & scale (CD-01..CD-08)
# ---------------------------------------------------------------------------
# Rate limiting (global token bucket, per instance). RATE_LIMIT_ENABLED=false disables.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
# Bearer token required to scrape /metrics (unset = open on private network).
METRICS_TOKEN=
# Hardening
CORS_ORIGIN=*
TRUST_PROXY=true
SERVER_REQUEST_TIMEOUT_MS=60000
# DataLake local fallback dir (default ./storage/datalake)
DATALAKE_LOCAL_DIR=./storage/datalake

# ---------------------------------------------------------------------------
# Billing (Phase 5B, B4) — seam de facturation, aucune clé RevenueCat pour l'instant.
# ---------------------------------------------------------------------------
# PAYWALL_ENFORCED=false (défaut) : bêta, ProEntitlementGuard ne bloque personne.
# Passer à true au lancement payant (voir BILLING.md).
PAYWALL_ENFORCED=false
# Secret de signature du provider factice (stub). Remplacé par le secret du
# provider réel au moment du basculement.
BILLING_WEBHOOK_SECRET=fake-billing-dev-secret
