PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Supabase PostgreSQL Database (Transaction Mode Pooler)
DATABASE_URL="postgresql://postgres.bjktawrigqjshmayutac:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Database (Session Mode Direct / Migrations)
DIRECT_URL="postgresql://postgres.bjktawrigqjshmayutac:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase Project Secret & URL
SUPABASE_PROJECT_REF=bjktawrigqjshmayutac
SUPABASE_URL=https://bjktawrigqjshmayutac.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT Auth Secret (From Supabase Project Settings -> API -> JWT Secret)
# REQUIRED - the server refuses to start when neither variable is set (fail closed).
# Generate one with: openssl rand -hex 32
# SECURITY: a default value used to be hardcoded here, in the source and in
# docker-compose.yml. That value is public now: treat it as compromised, never
# reuse it, and rotate it in Supabase (Project Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=
JWT_SECRET=
JWT_EXPIRATION=7d

# Webhooks Verification Tokens
STRAVA_VERIFY_TOKEN=riles_strava_webhook_token_2026
GARMIN_WEBHOOK_SECRET=riles_garmin_webhook_secret_2026
APPLE_HEALTH_SECRET=riles_apple_health_secret_2026

# Data Lake (Supabase Storage)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATALAKE_BUCKET_NAME=training-datalake

# Moteur LLM Multi-Provider (Gemini 3.5/3.8 Free Tier, OmniRoute :20128, Groq, OpenRouter)
# Option 1 (Défaut - Gratuit Google AI Studio) : https://generativelanguage.googleapis.com/v1beta/openai
# Option 2 (Gratuit Local OmniRoute) : http://localhost:20128/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
