datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkoutStatus {
  DONE     @map("done")
  SELECTED @map("selected")
  REST     @map("rest")
  UPCOMING @map("upcoming")
}

enum AuthProvider {
  EMAIL  @map("email")
  APPLE  @map("apple")
  GOOGLE @map("google")
}

enum PlanType {
  BASIC @map("basic")
  PRO   @map("pro")
}

enum ChallengeMetric {
  DISTANCE  @map("distance")
  DURATION  @map("duration")
  ELEVATION @map("elevation")
  SESSIONS  @map("sessions")
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  passwordHash   String?
  name           String
  initials       String
  readinessScore Int     @default(0)

  // Active Goal — RILES-014 : aucun objectif de démonstration par défaut.
  activeGoalTitle              String @default("")
  activeGoalTarget             String @default("")
  activeGoalRaceDate           String @default("")
  activeGoalWeeksRemaining     Int    @default(0)
  activeGoalProgressPercentage Int    @default(0)

  // Overall Stats & Physiological Load (Modèle de Banister : TSS, ATL, CTL, TSB)
  // RILES-014 : tous les défauts sont à l'état zéro — aucun kilométrage, score
  // ou charge fabriqué. Les fixtures de démonstration vivent dans prisma/seed.ts.
  activeWeeks    Int    @default(0)
  totalKm        Float  @default(0)
  completedRaces Int    @default(0)
  atlFatigue     Float  @default(0) // Charge aiguë 7j (Fatigue)
  ctlFitness     Float  @default(0) // Charge chronique 42j (Fitness)
  tsbForm        Float  @default(0) // Balance de stress (Forme = CTL - ATL)
  sleepScore     Int    @default(0)
  hrvStatus      String @default("")
  // FC max de l'athlète (RILES-021) : l'IF/TSS est calculé sur cette valeur,
  // jamais sur la FC max observée sur la séance. `null` = estimation
  // documentée (DEFAULT_ATHLETE_HRMAX).
  hrMax          Int?
  restHr         Int?

  // Account Preferences & State
  planType              PlanType     @default(PRO)
  // Fin de la période d'essai Pro (Phase 5B, B3). `null` = aucun essai.
  // L'entitlement est calculé par `isPro()` : planType PRO OU essai non expiré.
  trialEndsAt           DateTime?
  authProvider          AuthProvider @default(EMAIL)
  isOnboardingCompleted Boolean      @default(false)
  mainGoal              String?
  selectedSports        String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rules        LifeRule[]
  workouts     Workout[]
  rpeCheckIns  RpeCheckIn[]
  syncTokens   SyncToken[]
  chatMessages ChatMessage[]

  // Community (Phase 5B)
  ownedClubs        RunningClub[]
  runParticipations CommunityRunParticipant[]

  @@map("users")
}

model LifeRule {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  icon        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("life_rules")
}

model Workout {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey            String // "YYYY-MM-DD"
  dayName            String // "Lun", "Mar", "Mer", etc.
  dayNumber          Int
  month              Int // 0-11
  year               Int
  weekNumber         Int
  fullDateLabel      String // "MERCREDI 14 OCTOBRE"
  timeLabel          String? // "AUJOURD'HUI • 18:30"
  status             WorkoutStatus @default(UPCOMING)
  isRestDay          Boolean       @default(false)
  category           String // "SÉANCE QUALITATIVE"
  title              String // "Sortie Seuil & Allure Cible"
  duration           String // "1h15"
  distance           String // "14 km"
  targetPace         String // "4:50/km"
  targetZoneLabel    String // "Zone 3–4"
  targetZoneBpm      String // "158–172 bpm"
  targetZoneSegments Json // Array of { color: string, flex: number }
  pinPositionPercent Float         @default(50)
  effortBlocks       Json // Array of EffortBlock { title, durationLabel, type, flexRatio }
  tags               String[]      @default([])
  aiAdjustmentNote   String?
  tss                Float? // Training Stress Score de la séance
  sRpe               Float? // Charge sRPE = RPE × durée(min) (RILES-027)

  // Données complètes de la vraie séance réalisée (récupérées via Webhooks Strava / Garmin / Apple Santé)
  // Unique : une activité externe ne peut être écrite qu'une seule fois
  // (anti-rejeu / anti-double-écriture cross-utilisateur — RILES-006)
  externalActivityId  String?   @unique
  sourceProvider      String? // "strava", "garmin", "apple_health"
  actualDistanceKm    Float? // ex: 14.25
  actualDurationSec   Int? // ex: 4180
  actualPace          String? // ex: "4:53/km"
  actualAvgHeartRate  Int? // ex: 161
  actualMaxHeartRate  Int? // ex: 179
  actualElevationGain Float? // ex: 115.0
  actualCalories      Int? // ex: 820
  actualCadence       Int? // ex: 178
  actualSplitsJson    Json? // Détail km par km (splits_metric / laps)
  completedAt         DateTime?
  sportType           String?   @default("running") // "running", "cycling", "swimming", "strength", etc.
  isCommute           Boolean?  @default(false)
  secondaryActivities Json? // Array of { id, title, sportType, distanceKm, durationSec, durationLabel, paceOrSpeedLabel, isCommute }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rpeCheckIns RpeCheckIn[]

  @@unique([userId, dateKey])
  @@index([userId, weekNumber, year])
  @@index([userId, month, year])
  @@index([dateKey])
  @@map("workouts")
}

model RpeCheckIn {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId             String?
  workout               Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  rating                Int // 1 to 10
  feedbackLabel         String // "Très facile", "Modéré", "Difficile", "À fond"
  textComment           String? // Commentaire libre post-séance (Data Lake)
  perceivedLegs         String? // Ressenti musculaire (ex: "légères", "lourdes", "mollets raides")
  aiPreservationMessage String
  submittedAt           DateTime @default(now())

  @@index([workoutId])
  @@index([userId, submittedAt])
  @@map("rpe_checkins")
}

model SyncToken {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // "strava", "garmin", "polar", "coros", "suunto", "apple_health"
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  externalUserId String?
  isConnected    Boolean   @default(false)
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@map("sync_tokens")
}

model ChatMessage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender          String // "user", "coach", "system"
  text            String
  timestamp       String // "18:32"
  suggestedAction Json? // { type, label, applied, workoutId, details }
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("chat_messages")
}

model QuickPrompt {
  id      String @id @default(cuid())
  label   String
  message String
  order   Int    @default(0)

  @@map("quick_prompts")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String // "strava", "garmin", "apple_health"
  eventType   String // "activity.create", "health.summary", etc.
  objectId    String? // Identifiant externe de l'objet (activityId, summaryId, workoutUuid, empreinte du payload)
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  // Anti-rejeu / idempotence (RILES-006) : une même livraison
  // (provider, eventType, objectId) ne peut être enregistrée qu'une fois.
  @@unique([provider, eventType, objectId])
  @@map("webhook_events")
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  email       String   @unique
  goal        String? // semi | marathon | trail | 10k | reprise
  source      String? // hero | navbar | simulator | footer
  angle       String? // guilt | injury | garmin
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  locale      String   @default("fr")
  consentAt   DateTime // horodatage RGPD de la case obligatoire
  ipHash      String? // SHA-256 tronqué (anti-abus, jamais l'IP en clair)
  status      String   @default("waiting") // waiting | invited | rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@map("waitlist_entries")
}

// ---------------------------------------------------------------------------
// Community (Phase 5B) — clubs de course, sorties collectives, participants
// et défis mensuels. Strictement additif : aucune table existante modifiée.
// ---------------------------------------------------------------------------

model RunningClub {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String
  ownerId     String
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communityRuns CommunityRun[]

  @@index([ownerId])
  @@map("running_clubs")
}

model CommunityRun {
  id          String      @id @default(cuid())
  clubId      String
  club        RunningClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  location    String
  theme       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants CommunityRunParticipant[]

  @@index([clubId, scheduledAt])
  @@index([scheduledAt])
  @@map("community_runs")
}

model CommunityRunParticipant {
  id       String       @id @default(cuid())
  runId    String
  run      CommunityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime     @default(now())

  @@unique([runId, userId])
  @@index([userId, joinedAt])
  @@map("community_run_participants")
}

model MonthlyChallenge {
  id          String          @id @default(cuid())
  title       String
  metric      ChallengeMetric
  target      Float
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodStart, periodEnd])
  @@map("monthly_challenges")
}
